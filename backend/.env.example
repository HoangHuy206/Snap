# Application
APP_NAME=SnapQR
ENVIRONMENT=development
PORT=8000

# Frontend CORS (comma-separated origins for production, e.g. https://snapqr.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database: leave empty or sqlite for local dev; use PostgreSQL URL in production
# Example (Neon / Supabase / Railway Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/snapqr?sslmode=require
DATABASE_URL=sqlite:///./data/snapqr.db

# Storage: "auto" selects S3/R2 when S3_BUCKET & S3_ENDPOINT_URL (or AWS creds) are set, otherwise "local"
STORAGE_BACKEND=auto
LOCAL_STORAGE_DIR=./data/uploads

# Cloudflare R2 / AWS S3 Configuration (Production)
# Cloudflare R2 endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional custom public domain mapped to your R2 bucket (e.g. https://cdn.yourdomain.com)
S3_PUBLIC_BASE_URL=
# Optional: set true if R2 bucket CORS is configured and you want direct browser PUT uploads
USE_PRESIGNED_UPLOAD=false

# Upload & Expiry Policies
MAX_FILE_SIZE_MB=200
DEFAULT_EXPIRY_DAYS=7
MAX_EXPIRY_DAYS=30
RATE_LIMIT_PER_MINUTE=40

# Optional yt-dlp settings for production servers (if platforms rate-limit datacenter IPs)
YTDLP_PROXY=
YTDLP_COOKIES_FILE=
FFMPEG_PATH=

# Telegram Bot Feedback Notifications (optional; set in Railway/Render env, NEVER commit secrets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
